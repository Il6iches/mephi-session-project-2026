    1  ip link
    2  nmcli connection show
    3  nmcli connection modify enp0s3 ipv4.method auto
    4  nmcli connection up eth0
    5  nmcli connection up enp0s3
    6  hostnamectl set-hostname mephi-2026.domain.local
    7  ping -c 4 8.8.8.8 > ping.out
    8  dnf update -y
    9  dnf install -y nginx libcap-ng-utils
   10  dnf download --destdir=/tmp tcpdump
   11  rpm -ivh /tmp/tcpdump*.rpm
   12  rm -f /tmp/tcpdump*.rpm
   13  dnf download --arch=x86_64 --destdir=/tmp tcpdump
   14  dnf install -y libpcap
   15  rpm -ivh /tmp/tcpdump*x86_64.rpm
   16  dnf history > dnf.out
   17  parted -s /dev/sdb mklabel gpt mkpart primary ext4 0% 100%
   18  lsblk
   19  parted -s /dev/sdb mklabel gpt mkpart primary ext4 0% 100%
   20  mkfs.ext4 -L MEPHI_WEB /dev/sdb1
   21  lsblk
   22  mkdir -p /mephi-web
   23  echo "LABEL=MEPHI_WEB /mephi-web ext4 defaults 0 2" >> /etc/fstab
   24  mount -a
   25  df -hT /mephi-web
   26  systemctl enable --now nginx
   27  journalctl -u nginx -b > journalctl.out
   28  groupadd -g 5500 developers
   29  groupadd -g 4444 curators
   30  useradd -u 5501 -G developers user1
   31  useradd -u 5502 -G developers user2
   32  useradd -u 5503 -G developers user3
   33  useradd -u 4441 -G curators curator1
   34  useradd -u 4442 -G curators curator2
   35  mkdir -p /data/mephi-2026
   36  chown -R root:developers /data/mephi-2026
   37  chmod 2770 /data/mephi-2026
   38  setfacl -m g:developers:rwx /data/mephi-2026
   39  setfacl -m g:curators:r-x /data/mephi-2026
   40  setfacl -m o::--- /data/mephi-2026
   41  setfacl -d -m g:developers:rwx /data/mephi-2026
   42  setfacl -d -m g:curators:r-x /data/mephi-2026
   43  setfacl -d -m o::--- /data/mephi-2026
   44  chmod u-s /usr/sbin/tcpdump
   45  setcap cap_net_raw,cap_net_admin=eip /usr/sbin/tcpdump
   46  getcap /usr/sbin/tcpdump
   47  sudo -u user1 tcpdump -c 2 -i any
   48  getenforce
   49  semanage fcontext -a -t httpd_sys_content_t "/mephi-web(/.*)?"
   50  restorecon -Rv /mephi-web
   51  nano /etc/nginx/nginx.conf
   52  nginx -t && systemctl reload nginx
   53  nano /etc/pam.d/login
   54  nano /etc/security/access.conf
   55  cat << 'EOF' >> /etc/security/access.conf
- : (curators) : LOCAL
EOF

   56  nano /etc/login.defs
   57  sed -i 's/^PASS_MAX_DAYS.*/PASS_MAX_DAYS   90/' /etc/login.defs
   58  chage -M 90 user1
   59  chage -M 90 user2
   60  chage -M 90 user3
   61  chage -M 90 curator1
   62  chage -M 90 curator2
   63  nano /etc/security/pwquality.conf
   64  STUDENT_ID="372997"
   65  echo "Hello from Student: ${STUDENT_ID}" > /mephi-web/index.html
   66  chmod 644 /mephi-web/index.html
   67  restorecon -v /mephi-web/index.html
   68  curl http://localhost/
   69  mkdir -p ~/project-artifacts
   70  cd ~/project-artifacts
   71  ping -c 4 8.8.8.8 > ~/ping.out
   72  cp ~/ping.out ./ping.out
   73  stat /data/mephi-2026 > ~/stat.out
   74  stat /mephi-web >> ~/stat.out
   75  cp ~/stat.out ./stat.out
   76  getcap /usr/sbin/tcpdump > ~/getcap.out
   77  cp ~/getcap.out ./getcap.out
   78  dnf history > ~/dnf.out
   79  cp ~/dnf.out ./dnf.out
   80  journalctl -u nginx -b > ~/journalctl.out
   81  cp ~/journalctl.out ./journalctl.out
   82  getenforce > ~/getenforce.out
   83  cp ~/getenforce.out ./getenforce.out
   84  curl http://localhost/ > curl.out
   85  cp /etc/fstab ./fstab
   86  cp /etc/passwd ./passwd
   87  cp /etc/shadow ./shadow
   88  cp /etc/group ./group
   88  cp /etc/security/pwquality.conf ./pwquality.conf
   89  history > ~/history.out
